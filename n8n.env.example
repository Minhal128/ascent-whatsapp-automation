# Copy to n8n.env and fill in. n8n.env is gitignored - never commit real values.
# Loaded by start-n8n.ps1.

# --- Meta webhook -----------------------------------------------------------
# Any random string you invent. The same string goes into Meta when you add the
# callback URL, for both the Page (leadgen) and WhatsApp subscriptions.
META_VERIFY_TOKEN=

# System-user token with the leads_retrieval permission. Used to pull the
# lead's name/phone/email, which Meta's webhook deliberately does not include.
# Without it WhatsApp conversations still work, but Meta lead ads do not.
META_ACCESS_TOKEN=

# --- WhatsApp Cloud API -----------------------------------------------------
# Meta -> WhatsApp -> API Setup. The phone number ID is NOT the phone number.
WHATSAPP_PHONE_NUMBER_ID=
# The WhatsApp Business Account id. Not discoverable from most tokens - read it
# off the API Setup page, or run scripts/check-whatsapp-health.mjs.
WHATSAPP_WABA_ID=

# No access token here: the Send WhatsApp nodes use an n8n httpHeaderAuth
# credential instead, so the token stays in n8n's encrypted store.

# First contact must be an approved template. A free-form text only reaches
# someone who messaged the business number in the last 24 hours - outside that
# window Meta returns 200 with a message id and then silently drops it.
# hello_world/en_US is the sample Meta pre-approves on every new WABA.
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANG=en_US

# --- Google Sheets CRM ------------------------------------------------------
# The /d/<THIS>/edit part of the sheet URL. Tab must be named "Leads".
CRM_SHEET_ID=

# --- Google Calendar --------------------------------------------------------
# "primary" is the calendar of whichever account you connect. Use a dedicated
# calendar id if site visits should not sit in someone's personal one.
BOOKING_CALENDAR_ID=

# --- Business hours + locale ------------------------------------------------
# Kolkata: +91, IST (+05:30, no DST), 11:00-19:00.
DEFAULT_COUNTRY_CODE=91
BOOKING_UTC_OFFSET_MINUTES=330
BOOKING_OPEN_HOUR=11
BOOKING_CLOSE_HOUR=19
BOOKING_SLOT_MINUTES=60

# Conversation turns kept in the model prompt. Higher costs more per message.
MAX_HISTORY_TURNS=12

# --- Email notifications ----------------------------------------------------
# Uses an n8n SMTP credential; these only set the addresses.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Public webhook base ----------------------------------------------------
# Whatever puts this n8n on the public internet. A cloudflared quick tunnel
# gets a fresh hostname on every restart; re-run scripts/register-meta-callback.mjs
# after any restart.
N8N_PUBLIC_WEBHOOK_BASE=
WEBHOOK_URL=
